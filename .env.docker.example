# TrendRadar Docker Environment Template
# Copy to .env.docker on the target server (chmod 600).

APP_BASE_PATH=/radar
TRENDRADAR_HOST=127.0.0.1
TRENDRADAR_PORT=8000

TRENDRADAR_DB_PATH=/app/data/trendradar.db
TRENDRADAR_AGY_WORKSPACE=/app/data/agy-sandbox

# Generate a strong secret key on the server:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRENDRADAR_SECRET_KEY=CHANGE_ME_TO_RANDOM_URLSAFE_SECRET

# Optional: only needed on first run when users table is empty
# TRENDRADAR_ADMIN_USER=admin
# TRENDRADAR_ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD

TRENDRADAR_TIMEZONE=Asia/Shanghai

# Mounted host Antigravity CLI & mihomo HTTP proxy (via network_mode: host)
TRENDRADAR_AGY_BIN=/usr/local/bin/agy
TRENDRADAR_AGY_PROXY=http://127.0.0.1:7890
TRENDRADAR_AGY_MAX_CONCURRENCY=2
TRENDRADAR_AGY_TIMEOUT_SEC=180

TRENDRADAR_ENABLE_SCHEDULER=true
TRENDRADAR_SESSION_MAX_AGE_SEC=604800
TRENDRADAR_CORS_ORIGINS=
