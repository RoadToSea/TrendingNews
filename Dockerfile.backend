FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl sqlite3 tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

RUN groupadd -g 1000 liu && useradd -u 1000 -g 1000 -m -d /home/liu -s /bin/bash liu

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock /app/backend/
RUN cd /app/backend && uv sync --frozen --no-dev

COPY backend/app /app/backend/app

RUN mkdir -p /app/data \
    && chown -R 1000:1000 /app /home/liu

USER 1000:1000
WORKDIR /app/backend

ENV HOME=/home/liu \
    PYTHONUNBUFFERED=1 \
    PATH="/app/backend/.venv/bin:/usr/local/bin:${PATH}" \
    TRENDRADAR_DB_PATH=/app/data/trendradar.db

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${TRENDRADAR_PORT:-8000}/api/health || exit 1

CMD ["sh", "-c", "exec uvicorn app.main:app --host ${TRENDRADAR_HOST:-127.0.0.1} --port ${TRENDRADAR_PORT:-8000} --workers 1"]
