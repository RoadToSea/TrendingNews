# TrendRadar Web Backend Environment Template
# Copy to /etc/trendradar/backend.env on the target server (chmod 600).

APP_BASE_PATH=/radar
TRENDRADAR_HOST=127.0.0.1
TRENDRADAR_PORT=8000

# Single SQLite WAL file and isolated agy workspace
TRENDRADAR_DB_PATH=/home/liu/trendradar-data/trendradar.db
TRENDRADAR_AGY_WORKSPACE=/home/liu/trendradar-data/agy-sandbox

# Generate a 32-byte URL-safe secret:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRENDRADAR_SECRET_KEY=CHANGE_ME_TO_RANDOM_URLSAFE_SECRET

# Initial admin credentials (used ONLY on first startup when users table is empty)
TRENDRADAR_ADMIN_USER=admin
TRENDRADAR_ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD

TRENDRADAR_TIMEZONE=Asia/Shanghai

# Antigravity CLI configuration
TRENDRADAR_AGY_BIN=/home/liu/.local/bin/agy
TRENDRADAR_AGY_PROXY=http://127.0.0.1:7890
TRENDRADAR_AGY_MAX_CONCURRENCY=2
TRENDRADAR_AGY_TIMEOUT_SEC=180

TRENDRADAR_ENABLE_SCHEDULER=true
TRENDRADAR_SESSION_MAX_AGE_SEC=604800
TRENDRADAR_CORS_ORIGINS=
